# Copy to .env. docker compose reads it; the same names are used on EC2 (written by deploy/ec2/setup.sh).

# --- Postgres that holds the source (shop) and warehouse databases -------------------------------
# Locally this is the `postgres` compose service. On AWS it is the RDS endpoint.
PG_HOST=postgres
PG_PORT=5432
PG_USER=de_admin
PG_PASSWORD=change-me-local
PG_SSLMODE=disable
SHOP_DB=shop
WAREHOUSE_DB=warehouse

# Host port for the local Postgres container (5432 is often taken by a native install).
PG_HOST_PORT=5433

# --- Airflow metadata DB (always the local postgres container) ----------------------------------
AIRFLOW_DB_PASSWORD=change-me-airflow

# --- Bronze ingestion ---------------------------------------------------------------------------
# airbyte = trigger the Airbyte connection (needs `abctl local install` + scripts/airbyte_bootstrap.py)
# python  = built-in loader that writes the same bronze table shape (no Airbyte needed)
INGESTION_MODE=python
AIRBYTE_API_URL=http://host.docker.internal:8000/api/public/v1
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_CONNECTION_NAME=shop-to-bronze
# How Airbyte (running in its own kind cluster) reaches the databases.
AIRBYTE_PG_HOST=host.docker.internal
AIRBYTE_PG_PORT=5433

# --- Spark --------------------------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
